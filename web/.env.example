# Copy to .env.local for local development. These values are PUBLIC (they end up
# in the browser bundle) - never put secrets in a VITE_ variable.

# entra = sign in with Microsoft Entra ID | dev = no sign-in (API must also use AUTH_MODE=dev)
VITE_AUTH_MODE=entra
VITE_AZURE_TENANT_ID=<your-tenant-id>
# Application (client) ID of the "ProjectFlow Web" (SPA) app registration
VITE_SPA_CLIENT_ID=<spa-app-client-id>
# The API scope the SPA asks for: api://<api-app-client-id>/access_as_user
VITE_API_SCOPE=api://<api-app-client-id>/access_as_user
# Leave empty when the API serves the UI (Azure) or when using the Vite proxy (local)
VITE_API_BASE_URL=
