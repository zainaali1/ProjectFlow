# Copy to .env for local development (never commit .env - it is in .gitignore).

# ---------- Runtime ----------
NODE_ENV=development
PORT=3001

# ---------- Authentication (Microsoft Entra ID / Azure AD) ----------
# entra = validate Bearer tokens (recommended)
# dev   = no sign-in, fake "Local Developer" user (local only; refused when NODE_ENV=production)
AUTH_MODE=entra
AZURE_TENANT_ID=<your-tenant-id>
# Application (client) ID of the "ProjectFlow API" app registration
API_CLIENT_ID=<api-app-client-id>
API_SCOPE=access_as_user
# Set to true to allow changes only for users assigned the ProjectFlow.Manager app role
ENFORCE_ROLES=false
MANAGER_ROLE=ProjectFlow.Manager

# ---------- Data ----------
# mssql = Azure SQL (recommended) | memory = built-in demo data, no database needed
DATA_PROVIDER=mssql
SQL_SERVER=<your-server>.database.windows.net
SQL_DATABASE=projectflow
# aad-default = passwordless Entra auth: your `az login` locally, managed identity in Azure
# sql         = SQL username/password (set SQL_USER and SQL_PASSWORD)
SQL_AUTH=aad-default
# Only for a user-assigned managed identity:
# SQL_MANAGED_IDENTITY_CLIENT_ID=

# ---------- Web ----------
# Origins allowed to call the API from a browser (the Vite dev server)
CORS_ORIGINS=http://localhost:5173
